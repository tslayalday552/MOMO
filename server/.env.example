NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chatapp
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:8080
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5.6-luna
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
REVENUECAT_WEBHOOK_AUTH=replace_me
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ENTITLEMENT_ID=pro
MAX_INPUT_CHARS=20000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Firebase Admin SDK: server only. Project ID must match both mobile config files.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
# Absolute server-local path to a secret service-account JSON, never in mobile/.
# On managed hosting with a suitable attached Google identity, omit this and use ADC.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/momo-firebase-service-account.json
