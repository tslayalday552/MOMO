{
  "expo": {
    "name": "MOMO",
    "slug": "momo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aichat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tmdsickazzapps.momo",
      "googleServicesFile": "./GoogleService-Info.plist",
      "usesAppleSignIn": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.tmdsickazzapps.momo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#111111"
      },
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow $(PRODUCT_NAME) to securely store your session."
        }
      ],
      "expo-router",
      "expo-apple-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/messaging",
      "@react-native-google-signin/google-signin",
      "./plugins/withFirebaseAnalyticsNoAdId",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1",
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://api.example.com",
      "revenueCatAppleApiKey": "appl_REPLACE_ME",
      "revenueCatGoogleApiKey": "goog_REPLACE_ME",
      "revenueCatEntitlement": "pro_access",
      "appName": "MOMO",
      "companyName": "TMD-sickazzapps",
      "legalCompanyName": "TMD-sickazzapps",
      "supportEmail": "tay75love@gmail.com",
      "googleWebClientId": "REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com",
      "googleIosClientId": "REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com",
      "privacyPolicyUrl": "https://example.com/privacy"
    },
    "newArchEnabled": true
  }
}
